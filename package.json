{
  "name": "interstellar",
  "version": "5.2.6",
  "type": "module",
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=16.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-scramjet.mjs",
    "patch": "node scripts/patch-scramjet.mjs",
    "start": "node --max-old-space-size=3072 index.js",
