    "@mercuryworkshop/scramjet": "^1.1.0",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "@nebula-services/bare-server-node": "^2.0.4",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "chalk": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-basic-auth": "^1.2.1",
    "mime": "^4.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8"
